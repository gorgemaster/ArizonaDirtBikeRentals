---
import Layout from '../layouts/Layout.astro';
const title = 'Gallery - Arizona Dirt Bike Rentals';
const description = 'Photos from guided dirt bike tours and rentals in Wickenburg and the Phoenix, Arizona area — KTM and Husqvarna on epic desert singletrack.';

const images = [
  '2022/07/IMG_20210104_110215.jpg',
  '2022/07/IMG_20191109_103647.jpg',
  '2022/07/IMG_20200125_103543-1200px.jpg',
  '2022/07/IMG_20201001_100352.jpg',
  '2022/07/IMG_20220608_093817.jpg',
  '2022/07/IMG_20191124_115053.jpg',
  '2022/07/IMG_20201228_110251.jpg',
  '2022/07/IMG_20220619_100745.jpg',
  '2022/07/IMG_20200309_105455.jpg',
  '2022/07/20190325_115927_HDR.jpg',
  '2022/07/IMG_20210117_112816.jpg',
  '2022/07/IMG_20201214_121358.jpg',
  '2022/07/IMG_20200309_095955.jpg',
  '2022/07/IMG_20200301_094148.jpg',
  '2022/07/IMG_20200613_114752.jpg',
  '2022/07/IMG_20220608_102323.jpg',
  '2022/07/IMG_20200302_104805.jpg',
  '2022/07/IMG_20200226_120613.jpg',
  '2022/07/IMG_20191229_114026.jpg',
  '2018/02/20180211_120120.jpg',
  '2018/02/20180112_112416.jpg',
  '2018/02/20180211_120107.jpg',
  '2018/02/20171226_121455.jpg',
  '2018/02/20171201_121737.jpg',
  '2018/02/20180128_123738.jpg',
  '2018/02/20180114_120127.jpg',
  '2018/02/20180223_104546.jpg',
  '2018/02/20180112_120740.jpg',
  '2018/02/20180116_114312.jpg',
  '2018/02/20170224_195045717.jpeg',
  '2018/02/20170124_200908134.jpeg',
  '2018/02/20180211_1041510.jpg',
  '2018/02/2814.jpeg',
];
---
<Layout title={title} description={description}>

  <div class="page-hero">
    <div class="wrap">
      <div class="section-label">On the Trails</div>
      <h1 class="display">Photo Gallery.</h1>
    </div>
  </div>

  <section class="gallery-section">
    <div class="wrap">
      <div class="gallery-grid">
        {images.map((img, i) => (
          <button class="gallery-item" data-index={i} aria-label={`View photo ${i + 1}`}>
            <img src={`/images/${img}`} alt={`Arizona Dirt Bike Rentals trail riding photo ${i + 1}`} loading="lazy" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox">
    <div class="lb-backdrop"></div>
    <button class="lb-close" aria-label="Close lightbox">&times;</button>
    <button class="lb-prev" aria-label="Previous photo">&#8249;</button>
    <button class="lb-next" aria-label="Next photo">&#8250;</button>
    <div class="lb-img-wrap">
      <img id="lb-img" src="" alt="" />
    </div>
  </div>

  <script>
    const images = Array.from(document.querySelectorAll('.gallery-item'));
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lb-img');
    let current = 0;

    function open(index) {
      current = index;
      const src = images[current].querySelector('img').src;
      const alt = images[current].querySelector('img').alt;
      lbImg.src = src;
      lbImg.alt = alt;
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      lightbox.querySelector('.lb-close').focus();
    }

    function close() {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
      images[current].focus();
    }

    function prev() { open((current - 1 + images.length) % images.length); }
    function next() { open((current + 1) % images.length); }

    images.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    lightbox.querySelector('.lb-close').addEventListener('click', close);
    lightbox.querySelector('.lb-prev').addEventListener('click', prev);
    lightbox.querySelector('.lb-next').addEventListener('click', next);
    lightbox.querySelector('.lb-backdrop').addEventListener('click', close);

    document.addEventListener('keydown', e => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });
  </script>

  <section class="call-cta">
    <div class="section-label">Book Your Ride</div>
    <p class="reserve-label">Reserve Your Day</p>
    <a href="tel:5092810156" class="final-phone display">509 · 281 · 0156</a>
    <p class="final-note">Seven days a week · All year · Se habla español</p>
  </section>

</Layout>

<style>
  .page-hero { background: var(--cream-deep); border-bottom: 1px solid var(--line); padding: 80px 0; }
  .page-hero h1 { font-size: clamp(44px, 7vw, 96px); color: var(--leather); margin-bottom: 0; }

  .gallery-section { padding: 80px 0; background: var(--cream); }
  .gallery-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 600px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .gallery-grid { grid-template-columns: repeat(4, 1fr); } }

  .gallery-item {
    aspect-ratio: 1/1;
    overflow: hidden;
    background: var(--cream-deep);
    padding: 0;
    border: none;
    cursor: pointer;
    display: block;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }
  .gallery-item:hover img { transform: scale(1.06); }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .lightbox.is-open { display: flex; }
  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    cursor: pointer;
  }
  .lb-img-wrap {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lb-img-wrap img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
    box-shadow: 0 8px 64px rgba(0,0,0,0.6);
  }
  .lb-close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 2;
    background: none;
    border: none;
    color: #fff;
    font-size: 48px;
    line-height: 1;
    cursor: pointer;
    padding: 0 8px;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .lb-close:hover { opacity: 1; }
  .lb-prev, .lb-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    font-size: 56px;
    line-height: 1;
    cursor: pointer;
    padding: 16px 20px;
    opacity: 0.8;
    transition: opacity 0.2s, background 0.2s;
  }
  .lb-prev:hover, .lb-next:hover { opacity: 1; background: rgba(255,255,255,0.22); }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }

  .call-cta { background: var(--ink); color: var(--cream); text-align: center; padding: 80px 24px; border-top: 3px solid var(--rust); }
  .reserve-label { font-size: clamp(20px, 2vw, 28px); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rust); margin-bottom: 8px; }
  .final-phone { font-size: clamp(48px, 7vw, 96px); color: var(--rust); text-decoration: none; display: block; margin: 16px 0; letter-spacing: -0.01em; }
  .final-phone:hover { color: var(--cream); }
  .final-note { font-size: 19px; letter-spacing: 0.18em; text-transform: uppercase; color: #ffffff; font-weight: 600; }
</style>
