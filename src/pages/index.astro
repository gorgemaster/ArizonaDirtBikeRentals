---
import Layout from '../layouts/Layout.astro';
const title = 'Arizona Dirt Bikes — Coming Soon';
const description = 'Arizona Dirt Bikes — Ride. Race. Repeat.. Site launching soon.';
---
<Layout title={title} description={description}>
  <main class="min-h-screen flex items-center justify-center px-6" style="background:#b45309;color:#fff;">
    <div class="max-w-xl text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-white/60">Coming Soon</p>
      <h1 class="mt-4 text-5xl md:text-6xl font-semibold tracking-tight">Arizona Dirt Bikes</h1>
      <p class="mt-5 text-lg text-white/80">Ride. Race. Repeat.</p>
      <p class="mt-10 text-sm text-white/60">We're putting the finishing touches on something good. Check back soon.</p>
    </div>
  </main>
</Layout>
