---
import Layout from '../layouts/Layout.astro';
const title = 'Arizona Dirt Bike Rentals - KTM & Husqvarna Motorcycle Tours & Training';
const description = 'Off-road motorcycle tours, training, and moto rentals. Ride the latest Husqvarna and KTM dirt bikes and the best Wickenburg, Phoenix, Arizona moto trails.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Guided Dirt Bike Tours & Rentals for Advanced Riders',
  serviceType: 'Guided Off-Road Motorcycle Tour and Rental',
  description: 'All-inclusive guided dirt bike tours for advanced and expert riders in Wickenburg, Arizona. Ride the latest KTM and Husqvarna motorcycles on the best singletrack trails. $375 per rider per day — includes bike, full gear, lunch, and an expert trail guide. Operating since 2010.',
  url: 'https://arizonadirtbikerentals.com/dirt-bike-rentals-near-me/',
  areaServed: [
    { '@type': 'City', name: 'Wickenburg', containedInPlace: { '@type': 'State', name: 'Arizona' } },
    { '@type': 'City', name: 'Phoenix', containedInPlace: { '@type': 'State', name: 'Arizona' } },
  ],
  provider: {
    '@type': 'LocalBusiness',
    name: 'Arizona Dirt Bike Rentals',
    url: 'https://arizonadirtbikerentals.com',
  },
};

const reviews = [
  { quote: "My buddy and I flew out from New England to visit the area and rented bikes from Doug — was a very good experience. Clearly Doug is good at making the best of your skill level and was able to take me into some nice harder enduro areas. I will be back. Was nice to see what more Arizona has to offer.", author: "Jacob Gleason" },
  { quote: "We had an amazing dirt biking experience with Arizona Dirt Bike Rentals, thanks to Doug! The dirt bikes were top-notch, providing a thrilling ride. Doug's guidance was excellent — knowledgeable, friendly, and ensuring everyone had a blast. Highly recommend for an unforgettable adventure!", author: "Michael Colombo" },
  { quote: "Doug was a fantastic host, he set my group up with all the gear and motorcycles matching our size and ability. Our group rode Husky 450s with Rekluse clutches. Doug communicated effectively and matched trails with our abilities while keeping the riding a challenge.", author: "Adam Herried" },
  { quote: "Awesome experience! Doug set us up with all the gear we needed, had great knowledge of the trails and surrounding area and the bikes ran great! Doug was very accommodating to our skill levels and was fun to share the experience with. Would definitely recommend!", author: "Caitlin Sharp" },
  { quote: "I had an amazing time. Doug is a superb rider and down to earth gentleman. This only made me want to come back and do it again. I might even buy another bike after this experience. If you're thinking about it and not sure — just do it anyway.", author: "Jesse Ramos" },
  { quote: "This was one of the top 3 riding days in my life. Doug is an awesome host whether it's to put you at ease, give you riding tips or just being the good guy that he is. Well prepared KTM and Husky with top of the line accessories, Tubliss and Rekluse.", author: "Charles Lapierre" },
  { quote: "I can't say enough good things about my experience with Doug. He provides all the equipment you need and his bike set ups are awesome! I don't have a lot of riding experience, but Doug understood that and was very nice and patient with me.", author: "Jordan Moyer" },
  { quote: "Doug did a great job assessing my skills and selecting appropriate trails. We had a good time rippin' it up. He took me through a bunch of fun single track and mixed in some more open trails so I could catch my breath. I will do this again the next time I visit the Phoenix area.", author: "Doug Cooper" },
  { quote: "Doug was an amazing guide for our moto adventure!! The bikes he provided were top notch, ran perfectly, and even left me wanting an upgrade to my current moto! He picked us up, took us to some amazing trails, and gave us a few riding pointers along the way!", author: "Nick Hardin" },
];
---
<Layout title={title} description={description} schema={schema}>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <span class="eyebrow">Advanced &amp; Expert Riders</span>
      <h1 class="display">You Should Be<br>Out Riding.</h1>
      <p class="hero-sub">Every possible terrain you can imagine is here in Wickenburg. We've been dishing out the best singletrack since 2010.</p>
      <a href="tel:5092810156" class="btn btn-big">Call 509-281-0156</a>
    </div>
  </section>

  <section class="intro-section">
    <div class="wrap intro-grid">
      <div class="intro-text">
        <p>As an advanced rider you know what you want. We'll provide the best tools from KTM and Husqvarna to help you conquer any track.</p>
        <p>Check out the bikes and give Doug a call to line up your day.</p>
        <a href="/motorcycles/" class="btn" style="margin-top: 24px; display: inline-block;">See the Bikes</a>
      </div>
      <div class="intro-stats">
        <div class="stat">
          <span class="display stat-num">2010</span>
          <span class="stat-label">Established</span>
        </div>
        <div class="stat">
          <span class="display stat-num">500+</span>
          <span class="stat-label">Guided rides</span>
        </div>
        <div class="stat">
          <span class="display stat-num">5★</span>
          <span class="stat-label">Rated</span>
        </div>
      </div>
    </div>
  </section>

  <section class="reviews-section">
    <div class="wrap">
      <div class="section-label">Advanced Rider Reviews</div>
      <div class="reviews-grid">
        {reviews.map(r => (
          <blockquote class="review-card">
            <div class="stars">★★★★★</div>
            <p class="quote">{r.quote}</p>
            {r.author && <cite>— {r.author}</cite>}
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="video-section">
    <div class="wrap">
      <div class="section-label video-title">You Should Be Out Riding</div>
      <div class="video-embed">
        <div style="padding:177.78% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/1207542847?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;loop=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="Arizona Dirt Bike Rentals"></iframe></div><script is:inline src="https://player.vimeo.com/api/player.js"></script>
      </div>
    </div>
  </section>

  <section class="call-cta">
    <div class="section-label">Book Your Ride</div>
    <p class="reserve-label">Reserve Your Day</p>
    <a href="tel:5092810156" class="final-phone display">509 · 281 · 0156</a>
    <p class="final-note">Seven days a week · All year · Se habla español</p>
  </section>

</Layout>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: url('/images/2022/06/ADBR-Home-Slider1.jpg') center/cover no-repeat;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg,
      rgba(23,17,12,0.78) 0%,
      rgba(23,17,12,0.55) 35%,
      rgba(23,17,12,0.15) 65%,
      rgba(23,17,12,0) 100%);
  }
  @media (max-width: 800px) {
    .hero-bg::after {
      background: linear-gradient(180deg,
        rgba(23,17,12,0.85) 0%,
        rgba(23,17,12,0.55) 55%,
        rgba(23,17,12,0.35) 100%);
    }
  }
  .hero-content {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 80px 24px 100px;
    width: 100%;
  }
  .hero h1 {
    font-size: clamp(56px, 9.5vw, 132px);
    max-width: 14ch;
    margin-bottom: 26px;
    color: var(--cream);
    text-shadow: 0 2px 30px rgba(0,0,0,0.35);
  }
  .hero-sub {
    font-size: clamp(17px, 1.8vw, 21px);
    max-width: 48ch;
    margin-bottom: 40px;
    color: rgba(253,252,249,0.85);
  }

  .intro-section { padding: 80px 0; background: var(--cream-deep); border-bottom: 1px solid var(--line); }
  .intro-grid { display: grid; gap: 60px; align-items: center; }
  @media (min-width: 800px) { .intro-grid { grid-template-columns: 1fr 1fr; } }
  .intro-text p { font-size: 17px; color: var(--leather-soft); margin-bottom: 16px; max-width: 52ch; }

  .intro-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: center; }
  .stat { padding: 28px 12px; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--rust); min-width: 0; }
  .stat-num { font-size: clamp(28px, 4vw, 52px); color: var(--leather); display: block; }
  .stat-label { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--leather-soft); margin-top: 6px; display: block; }
  @media (max-width: 480px) {
    .intro-stats { grid-template-columns: 1fr; gap: 12px; }
    .stat { padding: 20px 16px; }
  }

  .reviews-section { padding: 100px 0; background: var(--cream); }
  .reviews-grid { display: grid; gap: 24px; margin-top: 48px; }
  @media (min-width: 600px) { .reviews-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .reviews-grid { grid-template-columns: repeat(3, 1fr); } }

  .review-card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--rust); padding: 28px 24px; }
  .stars { color: var(--rust); font-size: 18px; letter-spacing: 2px; margin-bottom: 14px; }
  .quote { font-size: 15px; color: var(--leather-soft); line-height: 1.65; margin-bottom: 14px; }
  cite { font-style: normal; font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rust); }

  .video-section { padding: 100px 0; background: var(--cream-deep); border-bottom: 1px solid var(--line); }
  .video-embed { max-width: 400px; margin: 48px auto 0; }
  .video-title { justify-content: center; }

  .call-cta { background: var(--ink); color: var(--cream); text-align: center; padding: 80px 24px; border-top: 3px solid var(--rust); }
  .reserve-label { font-size: clamp(20px, 2vw, 28px); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rust); margin-bottom: 8px; }
  .final-phone { font-size: clamp(48px, 7vw, 96px); color: var(--rust); text-decoration: none; display: block; margin: 16px 0; letter-spacing: -0.01em; }
  .final-phone:hover { color: var(--cream); }
  .final-note { font-size: 19px; letter-spacing: 0.18em; text-transform: uppercase; color: #ffffff; font-weight: 600; }

  @media (max-width: 899px) {
    .intro-text p { font-size: 20px; }
    .quote { font-size: 19px; }
  }
</style>
