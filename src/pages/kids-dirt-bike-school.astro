---
import Layout from '../layouts/Layout.astro';
const title = 'Kids Dirt Bike School & Lessons in Arizona - Ages 8 and Up';
const description = 'Kids dirt bike lessons and guided family rides in Wickenburg, Arizona. Ages 8 and up. Bikes, gear, and lunch included. $375 per rider.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kids Dirt Bike School',
  serviceType: 'Kids Dirt Bike Lessons and Guided Riding',
  description: 'Dirt bike lessons and guided rides for kids ages 8 and up in Wickenburg, Arizona. Includes all safety and riding gear, the latest motorcycles with custom upgrades, one-on-one training, kid-friendly trails, and lunch.',
  url: 'https://arizonadirtbikerentals.com/kids-dirt-bike-school/',
  areaServed: [
    { '@type': 'City', name: 'Wickenburg', containedInPlace: { '@type': 'State', name: 'Arizona' } },
    { '@type': 'City', name: 'Phoenix', containedInPlace: { '@type': 'State', name: 'Arizona' } },
  ],
  provider: {
    '@type': 'LocalBusiness',
    name: 'Arizona Dirt Bike Rentals',
    url: 'https://arizonadirtbikerentals.com',
  },
};

const daySteps = [
  { lead: 'Gear up.', body: 'We meet up and get every rider fitted. Helmet, goggles, boots, and pads all get sized before anyone touches a bike.' },
  { lead: 'Bike basics.', body: 'A safety talk and a walk through the controls. Clutch, throttle, brakes, and how to sit and stand on the bike. Nobody rides until they understand how it all works.' },
  { lead: 'First riding.', body: 'Wide open flat ground with plenty of space and one on one coaching. Starting, stopping, turning, and shifting. This is where the confidence gets built, and we stay here as long as your kid needs.' },
  { lead: 'Onto the trails.', body: 'Once your rider is steady, we head out. Doug rides in front and sets a pace that matches the slowest person in the group.' },
  { lead: 'Break and lunch.', body: 'Food, water, and shade. Kids talk nonstop about what they just did.' },
  { lead: 'More trail time.', body: 'Terrain steps up as skills improve. Sand washes, gentle hills, and some real desert singletrack if the group is ready for it.' },
  { lead: 'Wrap up.', body: "Photos, high fives, and a kid who won't stop talking about it on the drive home." },
];

const bringList = [
  'Long pants and a long sleeve shirt',
  'Socks that go up past the ankle',
  'Sunscreen and sunglasses',
  'A water bottle',
  'A change of clothes for the drive home',
  'A camera or phone for photos',
];

const faqs = [
  { q: 'How old does my child have to be?', a: "We start at age 8. Younger than that and most kids aren't big enough to safely handle the bikes we run." },
  { q: 'My kid has never ridden anything. Is that a problem?', a: 'Not at all. Most of the kids who come here are first timers, and the whole day is designed around teaching from zero.' },
  { q: 'How much does it cost?', a: '$375 per rider. That covers the bike, all safety gear, one on one instruction, guided trail time, snacks, and lunch.' },
  { q: 'Do I need to bring a bike or gear?', a: 'No. Everything is included and sized for your rider.' },
  { q: 'Can more than one kid come?', a: 'Yes. We take families and small groups all the time, and we adjust the day so every rider gets what they need.' },
  { q: 'How long is the day?', a: "Plan on three to five hours. That includes gear fitting, instruction, trail riding, and a lunch break. We go at your kid's pace rather than watching the clock." },
  { q: "What's the best time of year?", a: 'September through May is prime time. Summer mornings work too, but we start early to beat the heat.' },
  { q: 'Do you speak Spanish?', a: 'Sí. Se habla español.' },
  { q: 'How do I book?', a: "Call or text Doug at 509-281-0156. Every ride starts with a quick conversation about your kid's age, size, and experience so he can plan the day." },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      // Accent stripped here only, to avoid encoding issues in the JSON-LD; visible page text is unchanged.
      text: f.q === 'Do you speak Spanish?' ? 'Si. Se habla espanol.' : f.a,
    },
  })),
};

const reviews = [
  { quote: "Probably the best experience we've ever had as a family. We had experienced and novice riders and we were all able to ride, push our limits, and get the adrenaline pumping. We'll definitely make this an annual event.", author: "Greg Corniea" },
  { quote: "This riding experience was perfect and well worth a quick flight from Oregon. Doug had everything dialed for my son and I to have a great couple of days of riding. Looking forward to booking again soon.", author: "Darbey Budd" },
  { quote: "One of the top 3 riding days of my life. Doug is an awesome host, whether it's to put you at ease or give you a riding tip. Well-prepared KTM and Husky with top of the line accessories.", author: "Charles Lapierre" },
  { quote: "I don't have a lot of riding experience, and honestly I'm scared of heights, but Doug was patient and understanding. We've continued to rent because he's a wealth of information and a blast to be around.", author: "Jordan Moyer" },
  { quote: "Doug was legendary. My son had a blast and will definitely be doing it again. Top quality bikes, all the gear we needed, and a great area for beginners and experienced riders.", author: "Brandy McDonell" },
  { quote: "Doug did a great job assessing my skills and picking the right trails. I'll do this again next time I visit Phoenix.", author: "Doug Cooper" },
];
---
<Layout title={title} description={description} schema={[schema, faqSchema]}>

  <!-- Hero (ported from the homepage) -->
  <section class="hp-hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <span class="eyebrow">Wickenburg, Arizona · Since 2010</span>
      <h1 class="display">Give them a day they'll never stop <em>talking about.</em></h1>
      <p class="hero-sub">Unforgettable guided dirt bike rides in the Arizona desert. We bring the bikes, the gear, and 15 years of local knowledge. Perfect for families, kids, and advanced riders.</p>
      <div class="hero-ctas">
        <a href="tel:5092810156" class="btn btn-big" target="_blank" rel="noopener noreferrer">Call Doug to Reserve 509-281-0156</a>
      </div>
      <p class="hero-call-note">Every ride starts with a quick call. You'll talk directly to Doug.</p>
    </div>
  </section>

  <div class="page-hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <div class="section-label">For Ages 8 &amp; Up</div>
        <h1 class="display">Give your kids<br>an unforgettable<br>experience!</h1>
        <p class="hero-sub">We've got an awesome day planned for you and your kids.</p>
        <div class="kid-quotes">
          <div class="kid-quote">"That was insane!" <span>~ Toby</span></div>
          <div class="kid-quote">"OMG! I'm freakin' out!" <span>~ Marshall</span></div>
          <div class="kid-quote">"Wait til the guys see this!" <span>~ Andrew</span></div>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/kids-page.jpg" alt="Kid on dirt bike in Arizona desert" />
      </div>
    </div>
  </div>

  <section class="intro-lede">
    <div class="wrap intro-lede-inner">
      <span class="intro-bar" aria-hidden="true"></span>
      <p>Most kids who show up here have never touched a dirt bike. That's exactly who this day is built for. We start slow, in an open area with no traffic and nothing to run into, and we don't move on until your kid is ready. By lunch they're riding real trails through the Arizona desert with a grin they can't wipe off. Parents usually end up filming the whole thing.</p>
      <span class="intro-bar" aria-hidden="true"></span>
    </div>
  </section>

  <section class="split-section">
    <div class="wrap split-grid">
      <div class="split-photo">
        <img src="/images/2022/06/ADBR-Family-600x600.jpg" alt="Family riding dirt bikes in Arizona" />
      </div>
      <div class="split-text">
        <div class="section-label">No Experience Needed</div>
        <h2 class="display section-title">Never ridden before? Good.</h2>
        <p>You don't need any experience. You don't need to own gear. You don't need to know anything about motorcycles.</p>
        <p>Doug has spent 15 years teaching first-time riders, and he's figured out what works. Kids learn one thing at a time, at their own pace, and nobody gets pushed past what they're comfortable with. Some kids are ripping around in 20 minutes. Others take the whole morning to feel steady, and that's fine too. The day gets built around your kid, not the other way around.</p>
        <p>If your child is nervous, tell Doug when you call. He'll plan for it.</p>
      </div>
    </div>
  </section>

  <section class="day-section">
    <div class="wrap">
      <div class="section-label">The Schedule</div>
      <h2 class="display section-title">What the day looks like</h2>
      <div class="day-grid">
        <ol class="day-steps">
          {daySteps.map(step => (
            <li><strong>{step.lead}</strong> {step.body}</li>
          ))}
        </ol>
        <div class="day-photo">
          <img src="/images/2022/06/IMG_20200107_120230-1200px.jpg" alt="Kids learning to ride dirt bikes" />
        </div>
      </div>
      <p class="day-note">Most families are out here three to five hours. We don't run a clock on it. Some kids are ready to go big and want every minute, and some are grinning and worn out by hour three. Either way you get the same day, the same instruction, and the same price.</p>
    </div>
  </section>

  <section class="split-section">
    <div class="wrap split-grid">
      <div class="split-text">
        <div class="section-label">Safety First</div>
        <h2 class="display section-title">Safety comes first, every time</h2>
        <p>We hand out full gear for every rider, included in the price. That means a helmet, goggles, chest protector, knee pads, elbow pads, gloves, and boots. We stock kid sizes, so nothing is too big or sliding around.</p>
        <p>Every group rides with Doug leading. He keeps eyes on every rider, sets the pace for the slowest person in the group, and picks trails that match what your kid can handle that day. We ride on open desert land with no cars and no cross traffic.</p>
        <p>Bikes get set up for each rider before they climb on. Suspension, seat height, and the power delivery all get adjusted so the bike fits the kid instead of the kid fighting the bike.</p>
      </div>
      <div class="split-photo">
        <img src="/images/2022/06/ADBR-Kid-Protection-copy.jpg" alt="Kids dirt bike safety gear" />
      </div>
    </div>
  </section>

  <section class="copy-section">
    <div class="wrap">
      <div class="section-label">The Fleet</div>
      <h2 class="display section-title">The bikes</h2>
      <p>We run late model KTM and Husqvarna machines with upgrades, and we keep a range of sizes so we can match your child to the right bike. Small riders start on smaller displacement bikes with mellow power. Bigger or more confident kids move up.</p>
      <p>Everything is maintained in house. You're not renting a beat up loaner. These are the same quality bikes our advanced riders take out on technical trails.</p>
    </div>
  </section>

  <section class="copy-section alt">
    <div class="wrap">
      <div class="section-label">Family Day</div>
      <h2 class="display section-title">Parents ride too</h2>
      <p>This is a family day, not a drop off. Plenty of parents come out planning to watch and end up on a bike within the hour. We have adult sizes in bikes and gear, and Doug will teach you the same way he teaches your kid.</p>
      <p>If you'd rather stay on the sidelines with a camera, that works too. Some of the best photos our families have came from a mom who never left the truck.</p>
    </div>
  </section>

  <!-- Why Wickenburg (ported from the homepage) -->
  <section class="why" id="why">
    <div class="wrap">
      <div class="why-grid">
        <div class="why-image">
          <img src="/images/father-son.jpg" alt="Father and son in full riding gear giving thumbs up" />
        </div>
        <div class="why-text">
          <div class="section-label">Why Wickenburg</div>
          <h2 class="display section-title">15 years in the saddle. Thousands of happy riders.</h2>
          <p>That's why people fly in from Oregon, drive down from Canada, and come back year after year.</p>
          <div class="stats">
            <div>
              <div class="stat-num display">15+</div>
              <div class="stat-label">Years guiding</div>
            </div>
            <div>
              <div class="stat-num display">100+</div>
              <div class="stat-label">5-star reviews</div>
            </div>
            <div>
              <div class="stat-num display">$375</div>
              <div class="stat-label">All-inclusive day</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="copy-section">
    <div class="wrap">
      <div class="section-label">The Location</div>
      <h2 class="display section-title">Where we ride</h2>
      <p>We're based in Wickenburg, Arizona, about an hour northwest of Phoenix and an easy drive from Scottsdale, Glendale, Surprise, and Prescott. Families fly into Phoenix Sky Harbor, rent a car, and make a weekend of it.</p>
      <p>The terrain out here is why people keep coming back. Wide open desert, sandy washes, rolling hills, and hundreds of miles of trails that range from beginner flat to genuinely technical. Winter is beautiful, with sunshine and comfortable temperatures while the rest of the country is frozen.</p>
      <p>Need a ride? Pickup is available. Ask Doug when you call.</p>
    </div>
  </section>

  <section class="bring-section">
    <div class="wrap">
      <div class="section-label">Pack List</div>
      <h2 class="display section-title">What to bring</h2>
      <ul class="gear-list">
        {bringList.map(item => <li>{item}</li>)}
      </ul>
      <p class="bring-note">We handle the rest, including all gear, the bikes, snacks, and lunch.</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="wrap">
      <div class="section-label">Common Questions</div>
      <h2 class="display section-title">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map(item => (
          <div class="faq-item">
            <p class="faq-q">{item.q}</p>
            <p class="faq-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet Doug (ported from the homepage) -->
  <section class="meet" id="meet">
    <div class="wrap">
      <div class="meet-grid">
        <div class="meet-img">
          <img src="/images/doug-portrait.webp" alt="Doug McDonald, owner and guide" />
        </div>
        <div>
          <div class="section-label">Your Guide</div>
          <h2 class="display">Meet Doug.</h2>
          <p>Doug McDonald has been riding these trails and running this business since 2010. He's the guy who picks you up, sets up your bike, teaches the skills, and leads the ride.</p>
          <p>He'll meet you where you are as a rider and build a day around what you want out of it. That's why people come back year after year.</p>
          <a href="/contact-us/" class="btn" style="margin-top: 12px;">Plan Your Day with Doug</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews (ported from the homepage) -->
  <section class="proof" id="reviews">
    <div class="wrap">
      <div class="proof-header">
        <div class="section-label">What Riders Say</div>
        <h2 class="display section-title" style="margin: 0 auto 20px;">Over 150 five-star reviews.</h2>
        <div class="stars">★★★★★</div>
        <span class="count">Google &amp; Facebook verified</span>
      </div>
      <div class="reviews">
        {reviews.map(r => (
          <div class="review">
            <div class="review-stars">★★★★★</div>
            <p>{r.quote}</p>
            <cite>{r.author}</cite>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="call-cta">
    <div class="section-label">Book Your Day</div>
    <h2 class="display cta-heading">Your kids will remember this forever</h2>
    <p class="cta-lede">They'll remember the day they rode a dirt bike through the Arizona desert.</p>
    <p class="cta-lede">Call Doug and let's get it on the calendar.</p>
    <p class="reserve-label">Reserve Your Day</p>
    <a href="tel:5092810156" class="final-phone display">509 · 281 · 0156</a>
    <p class="final-note">Call Doug · Seven days a week · All year</p>
  </section>

</Layout>

<style>
  /* Hero (ported from the homepage; classes namespaced to avoid clashing with .page-hero below) */
  .hp-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
  }
  .hp-hero .hero-bg {
    position: absolute;
    inset: 0;
    background: url('/images/hero-main.webp') center/cover no-repeat;
  }
  .hp-hero .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg,
      rgba(23,17,12,0.78) 0%,
      rgba(23,17,12,0.55) 35%,
      rgba(23,17,12,0.15) 65%,
      rgba(23,17,12,0) 100%);
  }
  @media (max-width: 800px) {
    .hp-hero .hero-bg::after {
      background: linear-gradient(180deg,
        rgba(23,17,12,0.85) 0%,
        rgba(23,17,12,0.55) 55%,
        rgba(23,17,12,0.35) 100%);
    }
  }
  .hp-hero .hero-content {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 80px 24px 100px;
    width: 100%;
  }
  .hp-hero h1 {
    font-size: clamp(56px, 9.5vw, 132px);
    max-width: 14ch;
    margin-bottom: 26px;
    color: var(--cream);
    text-shadow: 0 2px 30px rgba(0,0,0,0.35);
  }
  .hp-hero h1 em { font-style: normal; color: var(--rust); }
  .hp-hero .eyebrow { font-size: 18px; }
  .hp-hero .hero-sub {
    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 700;
    max-width: 48ch;
    margin-bottom: 40px;
    color: rgba(253,252,249,0.85);
  }
  .hp-hero .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .hp-hero .hero-call-note {
    margin-top: 14px;
    font-size: clamp(16px, 1.5vw, 19px);
    color: #ffffff;
    font-style: italic;
  }

  .page-hero { background: var(--cream-deep); border-bottom: 1px solid var(--line); padding: 80px 0; }
  .hero-inner { display: grid; gap: 60px; align-items: center; }
  @media (min-width: 800px) { .hero-inner { grid-template-columns: 1fr 1fr; } }
  .page-hero h1 { font-size: clamp(40px, 5.5vw, 80px); line-height: 1.05; color: var(--leather); max-width: 18ch; margin-bottom: 20px; }
  .hero-sub { font-size: 31px; font-weight: 700; color: var(--leather); max-width: 54ch; margin-bottom: 32px; }
  .kid-quotes { display: flex; flex-direction: column; gap: 16px; }
  .kid-quote {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 900;
    font-size: clamp(28px, 4vw, 42px);
    color: var(--rust);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .kid-quote span {
    display: block;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--leather-soft);
    margin-top: 4px;
  }
  .hero-image { overflow: hidden; border: 1px solid var(--line); }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Opening lede */
  .intro-lede { background: var(--cream); padding: 90px 0 40px; }
  .intro-lede-inner { display: flex; align-items: center; justify-content: center; gap: 28px; max-width: 900px; text-align: left; }
  .intro-bar { flex: 0 0 4px; width: 4px; align-self: stretch; background: var(--rust); }
  .intro-lede p { font-size: clamp(19px, 1.8vw, 22px); font-weight: 500; color: var(--leather); line-height: 1.5; }
  @media (max-width: 700px) { .intro-bar { display: none; } }

  /* Image + text split sections */
  .split-section { background: var(--cream-deep); padding: 100px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .split-grid { display: grid; gap: 64px; align-items: center; }
  @media (min-width: 800px) { .split-grid { grid-template-columns: 1fr 1fr; } }
  .split-photo { overflow: hidden; border: 1px solid var(--line); aspect-ratio: 1/1; }
  .split-photo img { width: 100%; height: 100%; object-fit: cover; }
  .split-text p { font-size: 19px; color: var(--leather-soft); max-width: 54ch; margin-bottom: 16px; }
  .split-text p:last-child { margin-bottom: 0; }

  /* What the day looks like */
  .day-section { background: var(--cream); padding: 100px 0; }
  .day-grid { display: grid; gap: 56px; margin-top: 48px; align-items: start; }
  @media (min-width: 900px) { .day-grid { grid-template-columns: 1.4fr 1fr; } }
  .day-steps { list-style: none; padding-left: 0; }
  .day-steps li {
    padding: 20px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 19px;
    color: var(--leather-soft);
  }
  .day-steps li:first-child { padding-top: 0; }
  .day-steps li strong { color: var(--leather); font-weight: 800; }
  .day-photo { overflow: hidden; border: 1px solid var(--line); aspect-ratio: 3/4; position: sticky; top: 24px; }
  .day-photo img { width: 100%; height: 100%; object-fit: cover; }
  .day-note { font-size: 19px; color: var(--leather-soft); max-width: 68ch; margin-top: 48px; padding-top: 40px; border-top: 3px solid var(--rust); }

  /* Simple copy sections */
  .copy-section { background: var(--cream); padding: 100px 0; }
  .copy-section.alt { background: var(--cream-deep); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .copy-section p { font-size: 19px; color: var(--leather-soft); max-width: 62ch; margin-bottom: 16px; }
  .copy-section p:last-child { margin-bottom: 0; }

  /* Why Wickenburg (ported from the homepage) */
  .why { background: var(--cream); padding: 100px 0; border-bottom: 1px solid var(--line); }
  .why-grid { display: grid; gap: 64px; align-items: center; }
  @media (min-width: 900px) { .why-grid { grid-template-columns: 1fr 1fr; } }
  .why-image { position: relative; aspect-ratio: 4/5; overflow: hidden; border: 1px solid var(--line); }
  .why-image img { width: 100%; height: 100%; object-fit: cover; }
  .why-image::before {
    content: 'SINCE 2010';
    position: absolute;
    top: 0; right: 0;
    background: var(--rust);
    color: #fff;
    padding: 12px 18px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.2em;
    z-index: 2;
  }
  .why-text p { font-size: 19px; color: var(--leather-soft); margin-bottom: 20px; max-width: 48ch; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; padding-top: 44px; border-top: 3px solid var(--rust); }
  .stat-num { font-size: 60px; line-height: 0.9; color: var(--leather); }
  .stat-label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--leather-soft); font-weight: 700; margin-top: 8px; }

  /* Meet Doug (ported from the homepage) */
  .meet { padding: 100px 0; background: var(--cream-deep); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .meet-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 800px) { .meet-grid { grid-template-columns: 1fr 1.3fr; } }
  .meet-img { aspect-ratio: 1/1; overflow: hidden; border: 1px solid var(--line); }
  .meet-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .meet h2 { font-size: clamp(40px, 5.5vw, 72px); margin-bottom: 24px; color: var(--leather); }
  .meet p { font-size: 19px; color: var(--leather-soft); margin-bottom: 16px; max-width: 52ch; }

  /* What to bring */
  .bring-section { background: var(--cream-deep); padding: 100px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .gear-list { padding-left: 0; margin-top: 40px; max-width: 62ch; }
  .gear-list li {
    list-style: none;
    padding: 10px 0 10px 28px;
    position: relative;
